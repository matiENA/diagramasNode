# ==============================================================================
# CONFIGURACIÓN: LOCAL SUPABASE LOADER / EXTRACTOR (PLANTILLA)
# ==============================================================================
# Puerto local exclusivo (debe estar libre, por defecto 3010)
PORT=3010

# Frecuencia en minutos para el ciclo programado automático
SYNC_INTERVAL_MINUTES=15
KM_RAM_DIAS=60

# Supabase (Destino de carga y sincronización)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key
DATABASE_URL=postgresql://postgres.tu-proyecto:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
PG_MAX_CONNECTIONS=5
PG_IDLE_TIMEOUT=10000

# Google Service Account (Credenciales con permisos de lectura en Google Drive/Sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----\n"

