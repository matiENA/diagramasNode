      "parameters": {
        "jsCode": "const res = $input.first().json;\nreturn [{\n  json: {\n    timestamp: new Date().toLocaleString('es-AR'),\n    modulo: 'Marcas Master',\n    tablas_actualizadas: ['tractores (marca)', 'semis (marca)'],\n    marcas_inyectadas: res.job?.result?.records || 0,\n    duracion_seg: Math.round((res.job?.durationMs || 0) / 1000),\n    estado: '✅ Marcas oficiales de tractores y semis sincronizadas en Supabase'\n  }\n}];"
      },
