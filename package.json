{
  "name": "eor-backend",
  "version": "1.0.0",
  "description": "Backend Híbrido para Diagramas EOR",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:main": "node server.js",
    "start:main:local": "node -e \"process.env.KM_SERVICE_URL='http://localhost:3001'; require('./server.js')\"",
    "start:km": "node km-service/server.js",
    "dev:km": "node --watch km-service/server.js",
    "test:ram": "node scripts/test-ram-local.js",
    "test:pg": "node scripts/test-pg-ram.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.108.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "google-auth-library": "^10.7.0",
    "google-spreadsheet": "^5.3.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  }
}
